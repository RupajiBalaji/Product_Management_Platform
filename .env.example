# ─────────────────────────────────────────────────────────────────────────────
# Autonomous PM — Environment Variables Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Server Port & Mode
PORT=5000
NODE_ENV=production

# MongoDB Database Connection URI (e.g. MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/acube-pm?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/acube-pm

# Google Gemini API Key for AI Copilot & AI Summary Hub
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Session & JWT Security Secret
JWT_SECRET=your_super_secret_jwt_encryption_key_2026

# Firebase Client Configuration (Web Authentication)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=product-management-d2f7e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=product-management-d2f7e
VITE_FIREBASE_STORAGE_BUCKET=product-management-d2f7e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=390263177543
VITE_FIREBASE_APP_ID=1:390263177543:web:eced79c963c7834cef4c62

# API Base URL (Leave blank for single-service fullstack deployment on Render)
VITE_API_URL=
